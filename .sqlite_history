# Prüfe ob Admin existiert
admin = conn.execute('SELECT * FROM users WHERE username = "admin"').fetchone()
if not admin:
    # Lade Admin-Zugangsdaten aus config.json
    config = load_config()
    
    if config and 'admin' in config:
        # Verwende Zugangsdaten aus config.json
        username = config['admin']['username']
        password = config['admin']['password']
        
        # Erstelle Admin-Nutzer
        password_hash = generate_password_hash(password)
        conn.execute(
            'INSERT INTO users (username, password, role) VALUES (?, ?, ?)',
            (username, password_hash, 'admin')
        )
        conn.commit()
        
        print(f"Admin user created from config! Username: {username}")
    else:
        print("Error: No admin credentials found in config.json. Please add them and restart.")
